<Window x:Class="WPF_Data_Binding.Views.Demo2_DataContext"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Demo 2: DataContext - Nguon du lieu mac dinh"
        Height="550" Width="650"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <!--
        DataContext la gi?
        - La nguon du lieu MAC DINH cho TAT CA binding trong 1 control va cac control con
        - Khi dat DataContext cho Window → tat ca control ben trong co the dung {Binding PropertyName}
        - Giong nhu dat 1 cuon tu dien tren ban, tat ca nguoi trong nhom deu co the tra cuu

        Luu y quan trong:
        - Demo nay dung StudentBasic (KHONG co INotifyPropertyChanged)
        - Khi thay doi property cua student trong code → UI KHONG tu dong cap nhat
        - Nhung khi gan DataContext = object moi → UI SE cap nhat (vi WPF doc lai toan bo)
    -->

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Card hien thi thong tin -->
        <!--
            {Binding Name} = lay gia tri tu DataContext.Name
            {Binding Age} = lay gia tri tu DataContext.Age
            Khong can chi dinh nguon vi DataContext la nguon mac dinh
        -->
        <Border Grid.Row="0"
                Background="#F0F8FF"
                BorderBrush="#007BFF"
                BorderThickness="2"
                Padding="20"
                CornerRadius="5">
            <StackPanel>
                <TextBlock Text="THONG TIN SINH VIEN"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#007BFF"
                           Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Ho ten -->
                    <!-- {Binding Name}: tu dong lay gia tri tu DataContext.Name -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                              Text="Ho ten:" FontWeight="SemiBold"
                              Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                              Text="{Binding Name}"
                              FontSize="14" Margin="0,0,0,8"/>

                    <!-- Row 1: Tuoi -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                              Text="Tuoi:" FontWeight="SemiBold"
                              Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                              Text="{Binding Age}"
                              FontSize="14" Margin="0,0,0,8"/>

                    <!-- Row 2: Lop -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                              Text="Lop:" FontWeight="SemiBold"
                              Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                              Text="{Binding Class}"
                              FontSize="14" Margin="0,0,0,8"/>

                    <!-- Row 3: Email -->
                    <TextBlock Grid.Row="3" Grid.Column="0"
                              Text="Email:" FontWeight="SemiBold"
                              Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="3" Grid.Column="1"
                              Text="{Binding Email}"
                              FontSize="14" Margin="0,0,0,8"/>

                    <!-- Row 4: Diem TB -->
                    <!--
                        StringFormat='{}{0:F2}': format so thap phan 2 chu so
                        - {} o dau: escape character cho XAML parser
                        - {0:F2}: format tham so thu 0 voi 2 chu so thap phan
                        Vi du: 3.75 → "3.75", 3.5 → "3.50"
                    -->
                    <TextBlock Grid.Row="4" Grid.Column="0"
                              Text="Diem TB:" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="4" Grid.Column="1"
                              Text="{Binding GPA, StringFormat='{}{0:F2}'}"
                              FontSize="14" FontWeight="Bold" Foreground="#4CAF50"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Ghi chu -->
        <Border Grid.Row="1"
                Background="#FFF3E0" BorderBrush="#FF9800"
                BorderThickness="1" Padding="15" CornerRadius="5"
                Margin="0,15,0,0">
            <StackPanel>
                <TextBlock Text="LUU Y QUAN TRONG:" FontWeight="Bold" Foreground="#E65100"
                           Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#333">
                    <Run Text="- Demo nay dung StudentBasic (KHONG co INotifyPropertyChanged)"/>
                    <LineBreak/>
                    <Run Text="- Khi click 'Thay doi ten' → student.Name thay doi NHUNG UI khong cap nhat"/>
                    <LineBreak/>
                    <Run Text="- Khi click 'Load SV moi' → gan DataContext = object moi → UI cap nhat"/>
                    <LineBreak/>
                    <Run Text="- De UI tu dong cap nhat khi thay doi property → can INotifyPropertyChanged (Demo 3)"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Button actions -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <Button Content="Thay doi ten (khong cap nhat UI)"
                    Width="220" Height="35"
                    Background="#FF9800" Foreground="White"
                    Margin="0,0,10,0"
                    Click="ChangeName_Click"/>

            <Button Content="Load SV moi (cap nhat UI)"
                    Width="220" Height="35"
                    Background="#4CAF50" Foreground="White"
                    Click="LoadNewStudent_Click"/>
        </StackPanel>
    </Grid>
</Window>

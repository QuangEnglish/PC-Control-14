<Window x:Class="WPF_Data_Binding.Views.Demo1_ElementNameBinding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Demo 1: ElementName Binding - Bind giua cac Control"
        Height="650" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">

            <!-- ============================== -->
            <!-- VD 1: SLIDER DIEU CHINH FONTSIZE -->
            <!-- ============================== -->
            <!--
                ElementName Binding: Bind gia tri cua control nay sang control khac
                - ElementName = ten control nguon (phai co x:Name)
                - Path = thuoc tinh cua control nguon muon lay gia tri

                Vi du: Slider (nguon) → TextBlock (dich)
                Khi keo Slider → Value thay doi → FontSize cua TextBlock tu dong cap nhat
            -->
            <Border Background="White" Padding="20" Margin="0,0,0,15"
                    BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="VD 1: Slider dieu chinh kich thuoc chu"
                               FontSize="16" FontWeight="Bold" Foreground="#1E88E5"
                               Margin="0,0,0,15"/>

                    <Label Content="Dieu chinh kich thuoc chu:" FontWeight="Bold"/>

                    <!-- Slider la control nguon -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Nho" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- x:Name="sliderFontSize" dat ten de cac control khac co the tham chieu -->
                        <Slider x:Name="sliderFontSize"
                                Minimum="10"
                                Maximum="50"
                                Value="20"
                                Width="300"
                                VerticalAlignment="Center"/>

                        <TextBlock Text="Lon" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Hien thi gia tri hien tai cua Slider -->
                    <!--
                        ElementName=sliderFontSize: tham chieu den Slider co ten "sliderFontSize"
                        Path=Value: lay thuoc tinh Value cua Slider (gia tri hien tai)
                        StringFormat='{}{0:F0}': format so khong co chu so thap phan
                        - {} o dau: escape character de XAML hieu day la format string
                        - {0:F0}: format so voi 0 chu so thap phan
                    -->
                    <TextBlock Margin="0,10,0,0">
                        <Run Text="Kich thuoc hien tai: "/>
                        <Run Text="{Binding ElementName=sliderFontSize, Path=Value, StringFormat='{}{0:F0}'}"
                             FontWeight="Bold" Foreground="#1E88E5"/>
                        <Run Text=" px"/>
                    </TextBlock>

                    <!-- Text thay doi kich thuoc theo Slider -->
                    <!-- FontSize bind voi Value cua Slider → keo Slider = doi co chu -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="15"
                            Margin="0,15,0,0" Background="#F9F9F9" CornerRadius="3">
                        <TextBlock Text="Chu nay se thay doi kich thuoc khi ban keo slider phia tren!"
                                   FontSize="{Binding ElementName=sliderFontSize, Path=Value}"
                                   TextWrapping="Wrap"
                                   Foreground="#333"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================== -->
            <!-- VD 2: CHECKBOX BAT/TAT BUTTON -->
            <!-- ============================== -->
            <!--
                CheckBox.IsChecked (bool) bind voi Button.IsEnabled (bool)
                - Tick CheckBox → IsChecked=True → Button IsEnabled=True (bat)
                - Bo tick → IsChecked=False → Button IsEnabled=False (disabled/mo)
            -->
            <Border Background="White" Padding="20" Margin="0,0,0,15"
                    BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="VD 2: CheckBox bat/tat Button"
                               FontSize="16" FontWeight="Bold" Foreground="#4CAF50"
                               Margin="0,0,0,15"/>

                    <!-- CheckBox la control nguon -->
                    <CheckBox x:Name="chkEnable"
                              Content="Cho phep su dung Button"
                              IsChecked="True"
                              FontSize="14"
                              Margin="0,0,0,20"/>

                    <!-- Button bind IsEnabled voi CheckBox.IsChecked -->
                    <Button Content="Click me!"
                            Width="150" Height="40"
                            Background="#007BFF" Foreground="White" FontSize="14"
                            IsEnabled="{Binding ElementName=chkEnable, Path=IsChecked}"/>

                    <!-- Hien thi trang thai -->
                    <TextBlock Margin="0,15,0,0" Foreground="Gray" FontSize="12">
                        <Run Text="Trang thai Button: "/>
                        <Run Text="{Binding ElementName=chkEnable, Path=IsChecked}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ============================== -->
            <!-- VD 3: COMBOBOX THAY DOI MAU NEN -->
            <!-- ============================== -->
            <!--
                ComboBox chua cac ComboBoxItem, moi item co thuoc tinh Tag luu ten mau
                - Path=SelectedItem.Tag: lay thuoc tinh Tag cua item dang duoc chon
                - Khi chon item khac → SelectedItem thay doi → Tag thay doi → Background doi mau

                Luu y: Tag la thuoc tinh "tui do" cua moi FrameworkElement
                Co the luu bat ky gia tri gi vao Tag
            -->
            <Border Background="White" Padding="20" Margin="0,0,0,15"
                    BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="VD 3: ComboBox thay doi mau nen"
                               FontSize="16" FontWeight="Bold" Foreground="#FF9800"
                               Margin="0,0,0,15"/>

                    <Label Content="Chon mau nen:" FontWeight="Bold"/>

                    <!-- ComboBox chua danh sach mau -->
                    <!-- Tag cua moi item luu ten mau de WPF hieu -->
                    <ComboBox x:Name="cboColor"
                              Width="200" Height="30"
                              SelectedIndex="0"
                              HorizontalAlignment="Left"
                              Margin="0,5,0,20">
                        <ComboBoxItem Content="Trang" Tag="White"/>
                        <ComboBoxItem Content="Xanh nhat" Tag="LightBlue"/>
                        <ComboBoxItem Content="Vang nhat" Tag="LightYellow"/>
                        <ComboBoxItem Content="Hong nhat" Tag="LightPink"/>
                        <ComboBoxItem Content="Xanh la nhat" Tag="LightGreen"/>
                    </ComboBox>

                    <!-- Border doi mau theo ComboBox -->
                    <!-- Background bind voi SelectedItem.Tag cua ComboBox -->
                    <Border Width="400" Height="150"
                            BorderBrush="#CCC" BorderThickness="2" CornerRadius="5"
                            Background="{Binding ElementName=cboColor, Path=SelectedItem.Tag}">
                        <TextBlock Text="Mau nen thay doi theo lua chon!"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================== -->
            <!-- VD 4: SLIDER DIEU CHINH OPACITY -->
            <!-- ============================== -->
            <!--
                Ket hop nhieu ElementName Binding trong cung 1 UI
                - Slider 1: dieu chinh do trong suot (Opacity) cua hinh anh
                - Slider 2: dieu chinh kich thuoc (Width) cua hinh anh
            -->
            <Border Background="White" Padding="20"
                    BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="VD 4: Ket hop nhieu Binding"
                               FontSize="16" FontWeight="Bold" Foreground="#9C27B0"
                               Margin="0,0,0,15"/>

                    <!-- Slider do trong suot -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Do trong suot:" Width="120" VerticalAlignment="Center"/>
                        <Slider x:Name="sliderOpacity" Minimum="0.1" Maximum="1" Value="1" Width="200"/>
                        <TextBlock Text="{Binding ElementName=sliderOpacity, Path=Value, StringFormat='{}{0:P0}'}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Slider kich thuoc -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Kich thuoc:" Width="120" VerticalAlignment="Center"/>
                        <Slider x:Name="sliderSize" Minimum="50" Maximum="300" Value="150" Width="200"/>
                        <TextBlock Text="{Binding ElementName=sliderSize, Path=Value, StringFormat='{}{0:F0} px'}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Hinh vuong thay doi theo 2 slider -->
                    <Border HorizontalAlignment="Center"
                            Width="{Binding ElementName=sliderSize, Path=Value}"
                            Height="{Binding ElementName=sliderSize, Path=Value}"
                            Opacity="{Binding ElementName=sliderOpacity, Path=Value}"
                            Background="#9C27B0" CornerRadius="10">
                        <TextBlock Text="WPF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="24" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>

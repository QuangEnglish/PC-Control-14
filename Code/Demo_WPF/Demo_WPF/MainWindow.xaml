<Window x:Class="Demo_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo_WPF"
        mc:Ignorable="d"
        Title="Đăng Ký Tài Khoản"
        Height="450" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <!-- ============================================================ -->
    <!-- GIẢI THÍCH TỔNG QUAN:                                        -->
    <!-- - Window: Cửa sổ chính của ứng dụng WPF                     -->
    <!-- - Title: Tiêu đề hiển thị trên thanh title bar               -->
    <!-- - Height/Width: Kích thước cửa sổ (đơn vị pixel)            -->
    <!-- - WindowStartupLocation="CenterScreen": Mở ở giữa màn hình -->
    <!-- - ResizeMode="NoResize": Không cho phép kéo thay đổi kích thước -->
    <!-- ============================================================ -->

    <!-- ============================================================ -->
    <!-- GRID: Layout chính - chia giao diện thành lưới hàng x cột   -->
    <!-- Ở đây ta dùng 1 cột duy nhất, nhiều hàng                    -->
    <!-- ============================================================ -->
    <Grid Margin="30,20,30,20">

        <!-- ======================================================== -->
        <!-- ĐỊNH NGHĨA CÁC HÀNG (RowDefinitions)                    -->
        <!-- Height="Auto" : Hàng tự co theo nội dung bên trong      -->
        <!-- Height="*"    : Hàng chiếm hết phần còn lại             -->
        <!-- ======================================================== -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Hàng 0: Tiêu đề -->
            <RowDefinition Height="Auto"/>  <!-- Hàng 1: Tên đăng nhập -->
            <RowDefinition Height="Auto"/>  <!-- Hàng 2: Mật khẩu -->
            <RowDefinition Height="Auto"/>  <!-- Hàng 3: Email -->
            <RowDefinition Height="Auto"/>  <!-- Hàng 4: Giới tính -->
            <RowDefinition Height="Auto"/>  <!-- Hàng 5: CheckBox điều khoản -->
            <RowDefinition Height="*"/>     <!-- Hàng 6: Đẩy nút xuống dưới -->
            <RowDefinition Height="Auto"/>  <!-- Hàng 7: Nút Đăng ký / Hủy -->
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- HÀNG 0: TIÊU ĐỀ                                         -->
        <!-- TextBlock: Hiển thị text (chỉ đọc, không sửa được)      -->
        <!-- FontSize: Cỡ chữ                                         -->
        <!-- FontWeight="Bold": Chữ đậm                               -->
        <!-- HorizontalAlignment="Center": Căn giữa theo chiều ngang -->
        <!-- Margin="0,0,0,20": Lề (trái, trên, phải, DƯỚI=20px)    -->
        <!-- ======================================================== -->
        <TextBlock Grid.Row="0"
                   Text="ĐĂNG KÝ TÀI KHOẢN"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#2196F3"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- ======================================================== -->
        <!-- HÀNG 1: TÊN ĐĂNG NHẬP                                   -->
        <!-- StackPanel: Xếp các phần tử con theo chiều dọc/ngang    -->
        <!-- Orientation mặc định = Vertical (từ trên xuống dưới)     -->
        <!--                                                           -->
        <!-- Label: Nhãn mô tả cho ô nhập liệu                      -->
        <!--   - Content: Nội dung hiển thị                           -->
        <!--   - FontWeight="Bold": Chữ đậm                          -->
        <!--                                                           -->
        <!-- TextBox: Ô nhập liệu (người dùng gõ text vào đây)      -->
        <!--   - x:Name="txtUsername": Đặt tên để truy cập từ C#     -->
        <!--     (trong code-behind dùng: txtUsername.Text)           -->
        <!--   - Padding: Khoảng đệm bên trong ô                     -->
        <!-- ======================================================== -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Label Content="Tên đăng nhập:" FontWeight="Bold"/>
            <TextBox x:Name="txtUsername"
                     Padding="5,3"
                     FontSize="14"/>
        </StackPanel>

        <!-- ======================================================== -->
        <!-- HÀNG 2: MẬT KHẨU                                        -->
        <!-- PasswordBox: Giống TextBox nhưng ẩn ký tự (hiện dấu •)  -->
        <!--   - x:Name="txtPassword": Tên để truy cập từ C#         -->
        <!--     (trong code-behind dùng: txtPassword.Password)       -->
        <!--   - PasswordChar="●": Ký tự hiển thị thay cho mật khẩu -->
        <!-- ======================================================== -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <Label Content="Mật khẩu:" FontWeight="Bold"/>
            <PasswordBox x:Name="txtPassword"
                         Padding="5,3"
                         FontSize="14"
                         PasswordChar="●"/>
        </StackPanel>

        <!-- ======================================================== -->
        <!-- HÀNG 3: EMAIL                                             -->
        <!-- TextBox: Ô nhập email, tương tự ô tên đăng nhập         -->
        <!-- ======================================================== -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <Label Content="Email:" FontWeight="Bold"/>
            <TextBox x:Name="txtEmail"
                     Padding="5,3"
                     FontSize="14"/>
        </StackPanel>

        <!-- ======================================================== -->
        <!-- HÀNG 4: GIỚI TÍNH (RadioButton)                          -->
        <!-- RadioButton: Nút chọn 1 trong nhiều (mutual exclusive)   -->
        <!--   - GroupName="Gender": Cùng nhóm → chỉ chọn được 1     -->
        <!--     (chọn "Nam" thì "Nữ" tự bỏ chọn và ngược lại)     -->
        <!--   - IsChecked="True": Mặc định được chọn sẵn            -->
        <!--   - x:Name: Đặt tên để kiểm tra trong C#                -->
        <!--     (dùng: rbMale.IsChecked == true)                     -->
        <!--                                                           -->
        <!-- WrapPanel: Xếp các phần tử theo chiều ngang, tự xuống   -->
        <!--            dòng khi hết chỗ                               -->
        <!-- ======================================================== -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <Label Content="Giới tính:" FontWeight="Bold"/>
            <WrapPanel Margin="5,0,0,0">
                <RadioButton x:Name="rbMale"
                             Content="Nam"
                             GroupName="Gender"
                             IsChecked="True"
                             FontSize="14"
                             Margin="0,0,30,0"/>
                <RadioButton x:Name="rbFemale"
                             Content="Nữ"
                             GroupName="Gender"
                             FontSize="14"/>
            </WrapPanel>
        </StackPanel>

        <!-- ======================================================== -->
        <!-- HÀNG 5: CHECKBOX ĐIỀU KHOẢN                              -->
        <!-- CheckBox: Ô tích chọn (có thể chọn/bỏ chọn độc lập)    -->
        <!--   - Khác RadioButton: CheckBox không loại trừ lẫn nhau  -->
        <!--   - x:Name="chkAgree": Tên để kiểm tra trong C#         -->
        <!--     (dùng: chkAgree.IsChecked == true)                   -->
        <!--   - Content: Nội dung hiển thị bên cạnh ô tích          -->
        <!-- ======================================================== -->
        <CheckBox x:Name="chkAgree"
                  Grid.Row="5"
                  Content="Tôi đồng ý với điều khoản sử dụng"
                  FontSize="13"
                  Margin="5,5,0,0"/>

        <!-- ======================================================== -->
        <!-- HÀNG 7: NÚT BẤM (Button)                                 -->
        <!-- Button: Nút bấm - khi click sẽ gọi hàm xử lý (Event)  -->
        <!--   - Click="BtnRegister_Click": Gán sự kiện click        -->
        <!--     → Khi bấm nút, gọi hàm BtnRegister_Click trong C#  -->
        <!--   - Background: Màu nền của nút                          -->
        <!--   - Foreground: Màu chữ trên nút                        -->
        <!--   - Cursor="Hand": Con trỏ chuột đổi thành hình bàn tay-->
        <!--                                                           -->
        <!-- StackPanel Orientation="Horizontal": Xếp 2 nút ngang    -->
        <!-- HorizontalAlignment="Center": Căn giữa cả 2 nút        -->
        <!-- ======================================================== -->
        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button x:Name="btnRegister"
                    Content="ĐĂNG KÝ"
                    Width="130" Height="35"
                    FontSize="14" FontWeight="Bold"
                    Background="#4CAF50"
                    Foreground="White"
                    Cursor="Hand"
                    Margin="0,0,15,0"
                    Click="BtnRegister_Click"/>

            <Button x:Name="btnCancel"
                    Content="HỦY"
                    Width="130" Height="35"
                    FontSize="14" FontWeight="Bold"
                    Background="#F44336"
                    Foreground="White"
                    Cursor="Hand"
                    Click="BtnCancel_Click"/>
        </StackPanel>

    </Grid>
</Window>
